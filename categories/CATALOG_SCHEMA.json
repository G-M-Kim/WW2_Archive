{
  "source_required": [
    "id",
    "title",
    "institution_or_author",
    "publication_date",
    "source_type",
    "locator",
    "url",
    "accessed_at",
    "access_status",
    "claims_checked",
    "limitations",
    "rights"
  ],
  "question_required": [
    "id",
    "status",
    "question",
    "related_ids",
    "evidence",
    "completion_condition"
  ],
  "entity_id_pattern": "CAT-(DE|FR|GB|US|JP|IT|SU)-(EQP|PER|ORG|GEO)-[0-9]{4,}",
  "source_id_pattern": "CAT-(DE|FR|GB|US|JP|IT|SU)-SRC-[0-9]{4,}",
  "question_id_pattern": "CAT-(DE|FR|GB|US|JP|IT|SU)-RQ-[0-9]{4,}",
  "notes": [
    "미확인값은 null 또는 미확인으로 기록한다.",
    "한국어로 작성하며 자료 원제와 고유명사는 원문을 병기한다."
  ]
}
